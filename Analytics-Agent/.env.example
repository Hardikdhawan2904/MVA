# GROQ_API_KEY and POSTGRES_* now come from the repo-root .env by default —
# see ../.env.example. Uncomment below only to override them for this
# service specifically (local always wins over root).
# GROQ_API_KEY=your_groq_api_key_here
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# POSTGRES_DB=mva_pipeline
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# ── Dataset Path (local testing only) ─────────────────────────────────────────
# Only used by scripts/cli.py and train.py. The FastAPI service's POST
# /analyze always uses the uploaded file instead — this has no effect on it.
# DATASET_PATH=../test_data/insurance_variance_data_native.csv
