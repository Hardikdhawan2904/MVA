# Shared configuration for Agent 1 (Schema-Intelligence-Layer), Agent 3
# (Analytics-Agent), and Agent-Orchestrator — values genuinely identical
# across those three today. Agent 2 (Data-Profiling-Agent) is NOT
# covered here — it has its own DATABASE_URL/LLM_API_KEY-shaped config and
# its own .env, deliberately left untouched.
#
# Each service loads this file as a fallback UNDER its own local .env —
# local always wins on any key present in both. See that service's own
# .env.example for what stays local (ports, per-agent URLs, etc).
#
# Copy to .env and fill in GROQ_API_KEY.

GROQ_API_KEY=your_groq_api_key_here

# Shared Postgres — see Shared-Postgres/docker-compose.yml (host port 5433,
# mapped from the container's internal 5432 — not 5432 directly).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=mva_pipeline
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

LOG_LEVEL=INFO
